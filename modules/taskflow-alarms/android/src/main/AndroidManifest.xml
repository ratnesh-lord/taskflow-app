<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Show reminders (asked for at run time on Android 13 and later). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Put alarms back after the phone restarts. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Exact alarms: granted with the app on Android 13 and later, asked for on 12. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
  <!-- Lets the Reminders screen offer the "don't optimise battery" prompt. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <receiver android:name=".AlarmReceiver" android:exported="false" />
    <receiver android:name=".ActionReceiver" android:exported="false" />
    <receiver android:name=".SystemReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.TIME_SET" />
      </intent-filter>
    </receiver>

    <!-- Home-screen widgets (Widgets.kt). -->
    <receiver android:name=".TodayWidget" android:exported="true" android:label="@string/tf_widget_today_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/tf_widget_today_info" />
    </receiver>
    <receiver android:name=".PendingWidget" android:exported="true" android:label="@string/tf_widget_pending_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/tf_widget_pending_info" />
    </receiver>
    <receiver android:name=".ProductivityWidget" android:exported="true" android:label="@string/tf_widget_productivity_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/tf_widget_productivity_info" />
    </receiver>
    <receiver android:name=".NextReminderWidget" android:exported="true" android:label="@string/tf_widget_next_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/tf_widget_next_info" />
    </receiver>
    <receiver android:name=".WidgetReceiver" android:exported="false" />
  </application>
</manifest>
