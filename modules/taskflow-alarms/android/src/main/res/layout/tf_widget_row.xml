<?xml version="1.0" encoding="utf-8"?>
<!-- One task in Today's tasks: a 1 dp divider, then a 43 dp row (44 dp in all). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="44dp"
  android:orientation="vertical">
  <FrameLayout android:id="@+id/tf_divider" android:layout_width="match_parent" android:layout_height="1dp" />
  <LinearLayout
    android:id="@+id/tf_row"
    android:layout_width="match_parent"
    android:layout_height="43dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView android:id="@+id/tf_check" android:layout_width="40dp" android:layout_height="43dp" android:layout_marginStart="-12dp" android:paddingStart="12dp" android:paddingTop="13dp" android:paddingEnd="10dp" android:paddingBottom="12dp" android:src="@drawable/tf_widget_box" />
    <TextView android:id="@+id/tf_label" style="@style/TaskflowWidget.Regular" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="40dp" android:layout_marginEnd="8dp" android:maxLines="1" />
    <TextView android:id="@+id/tf_text" style="@style/TaskflowWidget.Medium" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" />
    <ImageView android:id="@+id/tf_priority" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" />
  </LinearLayout>
</LinearLayout>
