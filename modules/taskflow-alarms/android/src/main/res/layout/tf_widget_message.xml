<?xml version="1.0" encoding="utf-8"?>
<!-- Any widget before the app has sent data, or after signing out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/tf_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="16dp">
  <TextView android:id="@+id/tf_date" style="@style/TaskflowWidget.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TaskFlow" />
  <TextView android:id="@+id/tf_text" style="@style/TaskflowWidget.Regular" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="3" android:ellipsize="end" />
</LinearLayout>
