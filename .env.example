# Copy this file to .env and fill in the two values.
# Both are public: they ship inside the app. Row-level security in the database
# is what protects the data. Never put the service-role / secret key here.

# Supabase dashboard > Project Settings > Data API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard > Project Settings > API Keys > Publishable key
# (starts with sb_publishable_; the older "anon" key also works)
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Google Calendar, Tasks and Drive in the browser. The client ID of
# your Google "Web application" OAuth client (docs/SETUP.md, 6b). Public.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional: serve the web app below a sub-path, as GitHub Pages does
# (docs/DEPLOY.md). Leave unset to serve it at the root (npm run web).
# TASKFLOW_WEB_BASE_URL=/taskflow-app
